# Google Gemini (Nano Banana) — image generation. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pipeboard token for direct Meta Graph API calls (report/deploy scripts).
# Alternatively supply a raw Meta access token via META_ACCESS_TOKEN.
PIPEBOARD_API_TOKEN=
META_ACCESS_TOKEN=

# Telegram delivery for the daily report (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Adjust Report Service (optional, only if a project config sets adjust: true).
ADJUST_API_TOKEN=
